# These image names are also used as tags in tools/sim_build.sh.
# CUDA_IMAGE is the NVIDIA CUDA image used by the shared base stage.
ARG CUDA_IMAGE=nvcr.io/nvidia/cuda:13.3.0-cudnn-runtime-ubuntu22.04
# ROS2_HUMBLE_IMAGE is the shared ROS 2 Humble image built before this image.
ARG ROS2_HUMBLE_IMAGE=dronesimenv/ros2_humble:cuda13.3.0-humble


########################################################################
# shared base tools
########################################################################
# This stage contains tools that every DroneSimEnv container needs.
FROM ${CUDA_IMAGE} AS base_amd64

# Do not ask questions while packages are being installed.
ENV DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-c"]

# Install shared command-line tools only once.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    curl \
    git \
    gnupg2 \
    locales \
    lsb-release \
    python3-pip \
    software-properties-common \
    sudo \
    tmux \
    tzdata \
    wget \
    && rm -rf /var/lib/apt/lists/*


########################################################################
# ROS 2 Humble
########################################################################
# This stage adds ROS 2 Humble to the shared base image.
FROM base_amd64 AS ros2_humble

# Use UTF-8 text so ROS 2 tools and terminals can handle normal characters.
RUN locale-gen en_US.UTF-8 \
    && update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8
# LANG chooses UTF-8 as the default language encoding.
ENV LANG=en_US.UTF-8
# LC_ALL makes every locale category use UTF-8.
ENV LC_ALL=en_US.UTF-8

# Add the official ROS 2 package source, then install ROS 2 and build tools.
RUN curl -fsSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
        -o /usr/share/keyrings/ros-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu $(. /etc/os-release && echo $UBUNTU_CODENAME) main" \
        > /etc/apt/sources.list.d/ros2.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        ros-dev-tools \
        ros-humble-ament-cmake-clang-format \
        ros-humble-bondcpp \
        ros-humble-desktop \
        ros-humble-vision-msgs \
    && rm -rf /var/lib/apt/lists/* \
    && rosdep init \
    && rosdep update \
    && echo "source /opt/ros/humble/setup.bash" >> /root/.bashrc


########################################################################
# DDS agent
########################################################################
# This stage uses the shared ROS 2 image that sim_build.sh builds first.
FROM ${ROS2_HUMBLE_IMAGE} AS ros2-dds

SHELL ["/bin/bash", "-c"]

# Build the DDS agent that connects PX4 messages to ROS 2.
WORKDIR /DroneSimEnv
COPY tools/_git_clones/Micro-XRCE-DDS-Agent /DroneSimEnv/Micro-XRCE-DDS-Agent
RUN cmake \
        -S /DroneSimEnv/Micro-XRCE-DDS-Agent \
        -B /DroneSimEnv/Micro-XRCE-DDS-Agent/build \
    && cmake --build /DroneSimEnv/Micro-XRCE-DDS-Agent/build --parallel "$(nproc)" \
    && cmake --install /DroneSimEnv/Micro-XRCE-DDS-Agent/build \
    && ldconfig \
    && rm -rf /DroneSimEnv/Micro-XRCE-DDS-Agent


########################################################################
# Gazebo support
########################################################################
# This stage adds Gazebo Harmonic support for the drone service.
FROM ros2-dds AS ros2-dds-gzbridge
RUN curl -fsSL https://packages.osrfoundation.org/gazebo.gpg \
        -o /usr/share/keyrings/pkgs-osrf-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/pkgs-osrf-archive-keyring.gpg] https://packages.osrfoundation.org/gazebo/ubuntu-stable $(lsb_release -cs) main" \
        > /etc/apt/sources.list.d/gazebo-stable.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends ros-humble-ros-gzharmonic \
    && rm -rf /var/lib/apt/lists/*


########################################################################
# drone workspace
########################################################################
# This final stage builds the drone service's ROS 2 workspace.
FROM ros2-dds-gzbridge AS drone

# Copy and build only this service's ROS 2 workspace.
WORKDIR /DroneSimEnv/drone_ws
COPY drone/drone_ws/src /DroneSimEnv/drone_ws/src
# Add the cached PX4 ROS message package before building the workspace.
COPY tools/_git_clones/px4_msgs /DroneSimEnv/drone_ws/src/px4_msgs
RUN source /opt/ros/humble/setup.bash \
    && apt-get update \
    && rosdep install --from-paths src --ignore-src -r -y \
    && colcon build --symlink-install \
    && rm -rf /var/lib/apt/lists/* \
    && echo "source /DroneSimEnv/drone_ws/install/setup.bash" >> /root/.bashrc

WORKDIR /DroneSimEnv
CMD ["/bin/bash"]
