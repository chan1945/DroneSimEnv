# Build this image from the shared CUDA 13.3.0 and ROS 2 Humble image.
ARG ROS2_HUMBLE_IMAGE=dronesimenv/ros2_humble:cuda13.3.0-humble
FROM ${ROS2_HUMBLE_IMAGE}

SHELL ["/bin/bash", "-c"]

# Install tools and libraries used only by the ground station.
RUN apt-get update && apt-get install -y --no-install-recommends \
    gosu \
    gstreamer1.0-gl \
    gstreamer1.0-libav \
    gstreamer1.0-plugins-bad \
    libfuse2 \
    libpulse-mainloop-glib0 \
    libqt5gui5 \
    libx11-xcb1 \
    libxcb-cursor0 \
    libxcb-glx0 \
    libxcb-icccm4 \
    libxcb-image0 \
    libxcb-keysyms1 \
    libxcb-randr0 \
    libxcb-render-util0 \
    libxcb-shape0 \
    libxcb-sync1 \
    libxcb-xinerama0 \
    libxkbcommon-x11-0 \
    mesa-utils \
    net-tools \
    ruby \
    vim \
    && rm -rf /var/lib/apt/lists/*

# Run QGroundControl as a regular user instead of root.
WORKDIR /
RUN useradd -m -s /bin/bash qgcuser \
    && usermod -aG dialout qgcuser

# Download and unpack QGroundControl so the container can run it directly.
RUN wget -q https://d176tv9ibo4jno.cloudfront.net/latest/QGroundControl-x86_64.AppImage \
    && chmod +x QGroundControl-x86_64.AppImage \
    && ./QGroundControl-x86_64.AppImage --appimage-extract \
    && rm QGroundControl-x86_64.AppImage \
    && ln -s /squashfs-root/AppRun /usr/local/bin/qgc

# This helps GUI programs share an X11 display with the host.
ENV QT_X11_NO_MITSHM=1

# Copy and build only this service's ROS 2 workspace.
COPY ground/ground_ws/src /DroneSimEnv/ground_ws/src
WORKDIR /DroneSimEnv/ground_ws
RUN source /opt/ros/humble/setup.bash \
    && apt-get update \
    && rosdep install --from-paths src --ignore-src -r -y \
    && colcon build --symlink-install \
    && rm -rf /var/lib/apt/lists/* \
    && echo "source /DroneSimEnv/ground_ws/install/setup.bash" >> /root/.bashrc

WORKDIR /DroneSimEnv/ground_ws
# Start QGroundControl when a GUI display is available.
# Keep the container alive so sim_run.sh can open a tmux shell inside it.
# Stop child processes safely when Docker asks the container to exit.
CMD ["/bin/bash", "-lc", "set -Eeuo pipefail; \\
QGC_PID=''; \\
KEEPALIVE_PID=''; \\
cleanup() { \\
    if [[ -n \"${QGC_PID}\" ]] && kill -0 \"${QGC_PID}\" 2>/dev/null; then \\
        kill \"${QGC_PID}\" 2>/dev/null || true; \\
        wait \"${QGC_PID}\" 2>/dev/null || true; \\
    fi; \\
    if [[ -n \"${KEEPALIVE_PID}\" ]] && kill -0 \"${KEEPALIVE_PID}\" 2>/dev/null; then \\
        kill \"${KEEPALIVE_PID}\" 2>/dev/null || true; \\
        wait \"${KEEPALIVE_PID}\" 2>/dev/null || true; \\
    fi; \\
}; \\
trap cleanup EXIT; \\
trap 'exit 0' INT TERM; \\
if [[ -n \"${DISPLAY:-}\" || -n \"${WAYLAND_DISPLAY:-}\" ]]; then \\
    echo 'Starting QGroundControl...'; \\
    gosu qgcuser env HOME=/home/qgcuser DISPLAY=\"${DISPLAY:-}\" WAYLAND_DISPLAY=\"${WAYLAND_DISPLAY:-}\" XDG_RUNTIME_DIR=\"${XDG_RUNTIME_DIR:-}\" PULSE_SERVER=\"${PULSE_SERVER:-}\" QT_X11_NO_MITSHM=\"${QT_X11_NO_MITSHM:-1}\" qgc >/tmp/qgc.log 2>&1 & \\
    QGC_PID=$!; \\
    echo 'QGroundControl started. Logs: /tmp/qgc.log'; \\
else \\
    echo 'Skipping QGroundControl startup because no GUI display variables are set.'; \\
fi; \\
tail -f /dev/null & \\
KEEPALIVE_PID=$!; \\
wait \"${KEEPALIVE_PID}\""]
