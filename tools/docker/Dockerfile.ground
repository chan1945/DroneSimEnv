# ROS2_HUMBLE_IMAGE is the shared ROS 2 Humble image built by sim_build.sh.
ARG ROS2_HUMBLE_IMAGE=dronesimenv/ros2_humble:cuda13.3.0-humble

########################################################################
# ground image
########################################################################
# This image adds QGroundControl and the ground workspace to ROS 2 Humble.
FROM ${ROS2_HUMBLE_IMAGE}

SHELL ["/bin/bash", "-c"]

########################################################################
# ground tools
########################################################################
# Install tools and libraries used only by the ground station.
RUN apt-get update && apt-get install -y --no-install-recommends \
    gosu \
    gstreamer1.0-gl \
    gstreamer1.0-libav \
    gstreamer1.0-plugins-bad \
    libfuse2 \
    libpulse-mainloop-glib0 \
    libqt5gui5 \
    libx11-xcb1 \
    libxcb-cursor0 \
    libxcb-glx0 \
    libxcb-icccm4 \
    libxcb-image0 \
    libxcb-keysyms1 \
    libxcb-randr0 \
    libxcb-render-util0 \
    libxcb-shape0 \
    libxcb-sync1 \
    libxcb-xinerama0 \
    libxkbcommon-x11-0 \
    mesa-utils \
    net-tools \
    ruby \
    vim \
    && rm -rf /var/lib/apt/lists/*

# Run QGroundControl as a regular user instead of root.
WORKDIR /
RUN useradd -m -s /bin/bash qgcuser \
    && usermod -aG dialout qgcuser

# Download and unpack QGroundControl so the container can run it directly.
RUN wget -q \
        https://d176tv9ibo4jno.cloudfront.net/latest/QGroundControl-x86_64.AppImage \
    && chmod +x QGroundControl-x86_64.AppImage \
    && ./QGroundControl-x86_64.AppImage --appimage-extract \
    && rm QGroundControl-x86_64.AppImage \
    && ln -s /squashfs-root/AppRun /usr/local/bin/qgc

# QT_X11_NO_MITSHM avoids shared-memory problems when using the host X11 display.
ENV QT_X11_NO_MITSHM=1

########################################################################
# ground workspace
########################################################################
# Copy and build only this service's ROS 2 workspace.
WORKDIR /DroneSimEnv/ground_ws
COPY ground/ground_ws/src /DroneSimEnv/ground_ws/src
RUN source /opt/ros/humble/setup.bash \
    && apt-get update \
    && rosdep install --from-paths src --ignore-src -r -y \
    && colcon build --symlink-install \
    && rm -rf /var/lib/apt/lists/* \
    && echo "source /DroneSimEnv/ground_ws/install/setup.bash" >> /root/.bashrc

########################################################################
# QGroundControl lifecycle
########################################################################
WORKDIR /DroneSimEnv/ground_ws
# Run QGroundControl when a GUI display is available and keep the container alive.
COPY --chmod=755 tools/docker/ground-entrypoint.sh /usr/local/bin/ground-entrypoint.sh
CMD ["/usr/local/bin/ground-entrypoint.sh"]
