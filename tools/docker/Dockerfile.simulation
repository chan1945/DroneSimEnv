# 공통 ROS 2 이미지에 PX4 SITL·Gazebo·ROS-Gazebo 브리지와 simulation workspace를 설치·빌드하는 Dockerfile입니다.
# simulation.yml이 모델·월드 선택과 tmux 세션 구성을 관리하고 빌드된 PX4 실행 파일을 호출합니다.
# ROS2_HUMBLE_IMAGE: sim_build.sh가 먼저 빌드한 공통 ROS 2 이미지의 태그를 받아 FROM에서 사용합니다.
ARG ROS2_HUMBLE_IMAGE=dronesimenv/ros2_humble:cuda13.3.0-humble

########################################################################
# simulation 이미지 기반
########################################################################
# 전달받은 공통 ROS 2 이미지에서 시작해 이 서비스에 필요한 PX4·Gazebo와 workspace를 추가합니다.
FROM ${ROS2_HUMBLE_IMAGE}

# 이후 RUN에서 source로 ROS 환경을 로드할 수 있도록 실행 셸을 Bash로 지정합니다.
SHELL ["/bin/bash", "-c"]

########################################################################
# PX4 SITL
########################################################################
# sim_build.sh가 호스트에 준비한 PX4 소스를 Git 메타데이터·하위 모듈과 함께 이미지로 복사합니다.
WORKDIR /DroneSimEnv
COPY tools/_git_clones/PX4-Autopilot /DroneSimEnv/PX4-Autopilot

# PX4 제공 설치 스크립트로 개발 도구와 Gazebo 시뮬레이션 의존성을 설치합니다.
WORKDIR /DroneSimEnv/PX4-Autopilot
RUN bash ./Tools/setup/ubuntu.sh
# PATH: 기존 검색 경로 앞에 /root/.local/bin을 붙여 root 사용자용으로 설치된 PX4 보조 명령을 찾습니다.
ENV PATH="/root/.local/bin:${PATH}"

# QT_X11_NO_MITSHM: Qt의 X11 공유 메모리 사용을 꺼 호스트 화면을 공유할 때의 표시 충돌을 줄입니다.
ENV QT_X11_NO_MITSHM=1

# 이미지 빌드 중 px4_sitl 타깃을 컴파일해 실행 시 다시 빌드하지 않고 사용할 바이너리를 준비합니다.
RUN make px4_sitl

########################################################################
# Gazebo ROS 2 브리지
########################################################################
# PX4 설치 스크립트가 등록한 OSRF 저장소에서 Humble·Harmonic용 ROS-Gazebo 패키지를 설치합니다.
# Gazebo와 같은 컨테이너에서 센서·시계 토픽을 ROS 2 메시지로 변환합니다.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-humble-ros-gzharmonic \
    && rm -rf /var/lib/apt/lists/*

########################################################################
# simulation ROS 2 workspace
########################################################################
# simulation src를 전용 workspace에 복사하고 ROS 환경에서 rosdep·colcon으로 의존성 설치와 빌드를 수행합니다.
# --symlink-install을 사용하고 workspace 환경 로드를 .bashrc에 추가해 새 root Bash 셸에서 패키지를 찾게 합니다.
WORKDIR /DroneSimEnv/simulation_ws
COPY simulation/simulation_ws/src /DroneSimEnv/simulation_ws/src
RUN source /opt/ros/humble/setup.bash \
    && apt-get update \
    && rosdep install --from-paths src --ignore-src -r -y \
    && colcon build --symlink-install \
    && rm -rf /var/lib/apt/lists/* \
    && echo "source /DroneSimEnv/simulation_ws/install/setup.bash" >> /root/.bashrc

########################################################################
# Simulation tmux 시작 설정
########################################################################
# Simulation 스테이지에 Ruby와 tmuxinator를 설치해 YAML의 모델·월드와 창 구성을 읽습니다.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ruby \
    && rm -rf /var/lib/apt/lists/*
# Drone과 같은 tmuxinator 버전으로 프로젝트 설정을 해석해 서비스별 실행 동작을 맞춥니다.
RUN gem install tmuxinator --version 3.4.2 --no-document

# 이미지 단독 실행에도 기본 YAML을 제공하며 sim_run.sh는 같은 경로에 레포 설정을 연결합니다.
WORKDIR /DroneSimEnv/simulation_ws
COPY simulation/simulation.yml /DroneSimEnv/simulation.yml
# 브리지 토픽 매핑도 기본 파일로 제공하며 sim_run.sh가 레포 파일을 읽기 전용으로 연결합니다.
COPY simulation/ros_gz_bridge.yaml /DroneSimEnv/ros_gz_bridge.yaml
ENTRYPOINT ["tmuxinator", "start", "-p", "/DroneSimEnv/simulation.yml"]
