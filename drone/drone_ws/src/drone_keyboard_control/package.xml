<?xml version="1.0"?>
<!-- 두 조종 노드의 빌드 형식과 ROS·X11 실행 의존성을 선언합니다. -->
<package format="3">
  <name>drone_keyboard_control</name>
  <version>0.1.0</version>
  <description>Keyboard teleoperation and PX4 offboard control for DroneSimEnv SITL.</description>
  <maintainer email="heechan890@gmail.com">chan1945</maintainer>
  <license>Unspecified</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>px4_msgs</exec_depend>
  <exec_depend>python3-xlib</exec_depend>
  <exec_depend>tmux</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
