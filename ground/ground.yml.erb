# ground 컨테이너의 QGC 설정 초기화·실행과 대화형 셸을 tmux 창으로 구성하는 프로젝트 파일입니다.
# Docker ENTRYPOINT가 이 파일을 -p로 읽어 세션을 만들고, sim_run.sh의 xterm이 같은 세션에 접속합니다.
# name: sim_run.sh의 서비스 이름과 같은 ground를 세션 이름으로 사용해 기존 세션에 재접속할 수 있게 합니다.
name: ground
# root: 새 tmux 창의 시작 디렉터리를 컨테이너의 ground ROS 2 workspace로 지정합니다.
root: /DroneSimEnv/ground_ws

# on_project_start: tmux가 로그인 셸을 열기 전에 이름이 없는 보조 그룹을 컨테이너에 등록합니다.
# group_id: id -G에서 읽은 현재 프로세스의 숫자 GID이며, 미등록 GID만 host-gid-<GID> 이름으로 추가합니다.
# GPU 런타임이 전달한 그룹의 권한·ID는 유지하고 Bash의 groups 경고를 방지합니다.
on_project_start: for group_id in $(id -G); do if ! getent group "$group_id" >/dev/null; then groupadd --gid "$group_id" "host-gid-$group_id"; fi; done

# windows: 목록의 순서대로 QGC 출력 창과 별도 대화형 셸 창을 생성합니다.
windows:
  # qgc: 컨테이너의 설정 디렉터리를 준비하고 시작할 때마다 사용자 INI를 기본 INI로 교체한 뒤 QGC를 실행합니다.
  # root가 설정 디렉터리의 소유권을 맞추고 복사·쓰기 검사·QGC 실행은 qgcuser로 수행합니다.
  # 변경한 사용자 설정은 컨테이너 내부에만 저장하며 준비나 복사가 실패하면 QGC 실행을 중단하고 오류를 남깁니다.
  # 기본 INI를 임시 파일에 복사한 뒤 같은 디렉터리에서 이름을 바꿔 불완전한 복사본의 사용을 막습니다.
  # DISPLAY·WAYLAND_DISPLAY: 셸에서 미정의 값은 빈 문자열로 읽고 둘 중 하나라도 있으면 GUI 실행을 시도합니다.
  # HOME: QGC 프로세스에 /home/qgcuser를 전달해 설정·캐시·로그가 일반 사용자 홈을 기준으로 생성되도록 합니다.
  # bash -e는 복사 실패 시 즉시 종료하며 GUI 환경이 없을 때에도 INI 초기화는 수행합니다.
  - qgc: >-
      if install -d -o qgcuser -g qgcuser -m 0755 /home/qgcuser/.config/QGroundControl; then
        gosu qgcuser env HOME=/home/qgcuser bash -ec '
          cp /opt/dronesimenv/defaults/QGroundControl.ini /home/qgcuser/.config/QGroundControl/.QGroundControl.ini.initial;
          mv /home/qgcuser/.config/QGroundControl/.QGroundControl.ini.initial /home/qgcuser/.config/QGroundControl/QGroundControl.ini;
          echo "Initialized QGroundControl settings from the default INI.";
          if [[ ! -f /home/qgcuser/.config/QGroundControl/QGroundControl.ini || ! -r /home/qgcuser/.config/QGroundControl/QGroundControl.ini || ! -w /home/qgcuser/.config/QGroundControl/QGroundControl.ini ]]; then
            echo "ERROR: QGroundControl user INI must be a readable and writable file." >&2;
            exit 1;
          fi;
          if [[ -n "${DISPLAY:-}" || -n "${WAYLAND_DISPLAY:-}" ]]; then
            exec qgc;
          else
            echo "Skipping QGroundControl startup because no GUI display variables are set.";
          fi';
      else
        echo "ERROR: Could not prepare the QGroundControl settings directory." >&2;
      fi
  # shell: 실행할 명령을 비워 tmuxinator가 기본 셸을 열게 하며 QGC 종료 후에도 작업용 창을 제공합니다.
  - shell:
