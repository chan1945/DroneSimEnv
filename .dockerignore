# Keep this project's Git history and local agent files out of Docker builds.
.git
.agents
.codex

# PX4's Makefile and submodule checks need its real Git metadata during SITL builds.
# The other cached repositories only provide source files to their images.
tools/_git_clones/px4_msgs/.git
tools/_git_clones/Micro-XRCE-DDS-Agent/.git
!tools/_git_clones/PX4-Autopilot/.git
!tools/_git_clones/PX4-Autopilot/**/.git

# Ignore only generated workspace output; PX4 dependencies contain source log directories.
drone/drone_ws/build
drone/drone_ws/install
drone/drone_ws/log
ground/ground_ws/build
ground/ground_ws/install
ground/ground_ws/log
simulation/simulation_ws/build
simulation/simulation_ws/install
simulation/simulation_ws/log
tools/_git_clones/PX4-Autopilot/build
tools/_git_clones/Micro-XRCE-DDS-Agent/build

# Downloaded Gazebo assets are mounted from the host when sim_run.sh starts.
simulation/simulation_ws/src/simulation_resources/worlds/*
simulation/simulation_ws/src/simulation_resources/drone_models/*
!simulation/simulation_ws/src/simulation_resources/worlds/.gitkeep
!simulation/simulation_ws/src/simulation_resources/drone_models/.gitkeep

# Editor and operating-system files are not needed inside images.
.DS_Store
*.swp
