# Build this image from the shared CUDA 13.3.0 and ROS 2 Humble image.
ARG ROS2_HUMBLE_IMAGE=dronesimenv/ros2_humble:cuda13.3.0-humble
FROM ${ROS2_HUMBLE_IMAGE}

SHELL ["/bin/bash", "-c"]

# Download PX4 and its source dependencies for the simulator.
WORKDIR /DroneSimEnv
RUN git clone --recursive --branch v1.16.1 \
        https://github.com/PX4/PX4-Autopilot.git /DroneSimEnv/PX4-Autopilot

WORKDIR /DroneSimEnv/PX4-Autopilot

# Install the packages PX4 needs, then make its helper tools available.
RUN bash ./Tools/setup/ubuntu.sh
ENV PATH="/root/.local/bin:${PATH}"

# This helps GUI programs share an X11 display with the host.
ENV QT_X11_NO_MITSHM=1

# Build PX4 SITL once while the Docker image is being made.
RUN make px4_sitl

# Copy and build only this service's ROS 2 workspace.
COPY simulation/simulation_ws/src /DroneSimEnv/simulation_ws/src
WORKDIR /DroneSimEnv/simulation_ws
RUN source /opt/ros/humble/setup.bash \
    && apt-get update \
    && rosdep install --from-paths src --ignore-src -r -y \
    && colcon build --symlink-install \
    && rm -rf /var/lib/apt/lists/* \
    && echo "source /DroneSimEnv/simulation_ws/install/setup.bash" >> /root/.bashrc

WORKDIR /DroneSimEnv/PX4-Autopilot
CMD ["/bin/bash"]
